{
  "name": "@acertijosapps/react-native-bottom-tab-bar",
  "version": "1.0.0",
  "description": "Floating, animated bottom tab bar for React Navigation (bottom-tabs v7) built on Reanimated.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.*"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "clean": "rm -rf lib",
    "example": "yarn --cwd example",
    "prepare": "bob build",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "keywords": [
    "react-native",
    "react-navigation",
    "bottom-tabs",
    "tab-bar",
    "floating-tab-bar",
    "reanimated",
    "ios",
    "android",
    "swipe"
  ],
  "author": "AcertijosApps <acertijos.contacto@gmail.com> (https://acertijosapps.com/librerias)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/acertijoslibs/rnbottomtabbar.git"
  },
  "homepage": "https://acertijosapps.com/librerias/react-native-bottom-tab-bar",
  "bugs": {
    "url": "https://gitlab.com/acertijoslibs/rnbottomtabbar/-/issues"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "@react-navigation/native": ">=7.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.3.11",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "react-native-worklets": "^0.11.1",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
